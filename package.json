{
  "name": "openliulan",
  "version": "1.1.0",
  "description": "整合 Browser-Use / Stagehand / Chrome DevTools MCP / Playwright MCP 的统一 AI 浏览器控制框架，强化调试诊断能力并适配 deepseek harness 与 cnb.cool",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@openliulan/core --workspace=@openliulan/diagnosis --workspace=@openliulan/token --workspace=@openliulan/ai-layer --workspace=@openliulan/stealth --workspace=@openliulan/engines --workspace=@openliulan/scripting --workspace=@openliulan/mcp-server --workspace=@openliulan/viz",
    "test": "vitest run",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "node examples/quickstart.mjs"
  },
  "keywords": [
    "browser-automation",
    "ai-agent",
    "playwright",
    "mcp",
    "chrome-devtools",
    "browser-use",
    "stagehand"
  ],
  "dsh": {
    "bundle": {
      "patch": "patch.dsh"
    }
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
