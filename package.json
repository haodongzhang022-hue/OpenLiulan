{
  "name": "@openliulan/dsh-openliulan",
  "version": "1.2.0",
  "description": "整合 Browser-Use / Stagehand / Chrome DevTools MCP / Playwright MCP 的统一 AI 浏览器控制框架，强化调试诊断能力并适配 deepseek harness 与 cnb.cool；可安装为 DSH 插件包（一条命令安装到 dsh web profile）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@openliulan/core --workspace=@openliulan/diagnosis --workspace=@openliulan/token --workspace=@openliulan/ai-layer --workspace=@openliulan/stealth --workspace=@openliulan/engines --workspace=@openliulan/scripting --workspace=@openliulan/mcp-server --workspace=@openliulan/viz",
    "build:plugin": "node scripts/build-plugin.mjs",
    "prepack": "node scripts/build-plugin.mjs",
    "test": "vitest run",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "node examples/quickstart.mjs"
  },
  "keywords": [
    "browser-automation",
    "ai-agent",
    "playwright",
    "mcp",
    "chrome-devtools",
    "browser-use",
    "stagehand",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "dependencies": {
    "playwright": "^1.45.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.2.7",
    "esbuild": "^0.28.0"
  },
  "license": "MIT"
}
